SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=api.wolbiroyal.com,your-backend.up.railway.app,localhost

DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=5432
DB_SCHEMA=wolbi

CORS_ALLOWED_ORIGINS=https://wolbiroyal.com,https://www.wolbiroyal.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://api.wolbiroyal.com,https://wolbiroyal.com,https://www.wolbiroyal.com

# Cloudflare R2 media storage (leave blank locally to save uploads to backend/media/)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=wolbi-media
# Public host for the bucket (custom domain or pub-xxxx.r2.dev); blank = private bucket + signed URLs
R2_PUBLIC_DOMAIN=media.wolbiroyal.com

# Email (Resend) — wolbiroyal.com must be verified under Resend -> Domains
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@wolbiroyal.com
EMAIL_FROM_NAME=Wolbi Royal Enterprise
# A real inbox that client replies go to (noreply@ is never read)
REPLY_TO_EMAIL=hello@wolbiroyal.com
# Per-division mailboxes (defaults shown; each needs a Cloudflare Email Routing rule)
EMAIL_DOMAIN=wolbiroyal.com
EMAIL_TECHNOLOGIES=tech@wolbiroyal.com
EMAIL_MEDICAL=medical@wolbiroyal.com
EMAIL_VIRTUAL=virtual@wolbiroyal.com
EMAIL_FOUNDATION=foundation@wolbiroyal.com
# Teleconsultation video (daily.co). Reminders: run `python manage.py send_consultation_reminders` every ~10 min
DAILY_API_KEY=your-daily-api-key
# Inbox(es) that get a copy of every new request/booking/volunteer alert, comma-separated
STAFF_ALERT_EMAILS=you@wolbiroyal.com
# Used to build links inside emails
SITE_URL=https://wolbiroyal.com
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
